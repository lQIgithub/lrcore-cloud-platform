<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.lrcore</groupId>
        <artifactId>lrcore-ai-modules</artifactId>
        <version>v1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>lrcore-ai</artifactId>
    <name>ai业务实现</name>
    <description>
        lrcore-ai实现模块
    </description>

    <dependencies>
        <!-- web场景开发核心模块 -->
        <dependency>
            <groupId>com.lrcore</groupId>
            <artifactId>lrcore-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lrcore</groupId>
            <artifactId>lrcore-common-ai</artifactId>
        </dependency>

    </dependencies>

    <build>
        <finalName>${service-name-ai}-${nacos.active}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
